# KBO moneyline 배당을 가져올 The Odds API 키
PLAYBALL_ODDS_API_KEY=

# 북메이커 지역. 지역 수만큼 API 요청 비용이 늘어나므로 기본값은 유럽 한 곳입니다.
PLAYBALL_ODDS_REGIONS=eu

# 배당 응답 캐시 시간(초). 무료 쿼터 보호를 위해 기본 1시간입니다.
PLAYBALL_ODDS_CACHE_SECONDS=3600

# 역배 추천 임계값(소수: 0.08 = 8%)
PLAYBALL_UPSET_MIN_EV=0.08
PLAYBALL_UPSET_MIN_EDGE=0.05
PLAYBALL_UPSET_MIN_ADVANTAGE=0.10
