# KBO moneyline 배당을 가져올 The Odds API 키
PLAYBALL_ODDS_API_KEY=

# 북메이커 지역. 지역 수만큼 API 요청 비용이 늘어나므로 기본값은 유럽 한 곳입니다.
PLAYBALL_ODDS_REGIONS=eu

# 재시작 때 복구할 배당 응답의 최대 경과 시간(초). 추가 API 호출은 하지 않습니다.
PLAYBALL_ODDS_CACHE_SECONDS=3600
PLAYBALL_ODDS_MIN_BOOKMAKERS=2
PLAYBALL_ODDS_MAX_AGE_MINUTES=60
PLAYBALL_ODDS_CLOSE_BEFORE_MINUTES=10

# 역배 추천 임계값(소수: 0.08 = 8%)
PLAYBALL_UPSET_MIN_EV=0.08
PLAYBALL_UPSET_MIN_EDGE=0.05
PLAYBALL_UPSET_MIN_ADVANTAGE=0.10

# 분석 캐시·동시 실행·백그라운드 수집
PLAYBALL_ANALYSIS_CACHE_SECONDS=600
PLAYBALL_ANALYSIS_CACHE_ENTRIES=32
PLAYBALL_MAX_CONCURRENT_ANALYSES=4
PLAYBALL_COLLECT_INTERVAL_SECONDS=900
PLAYBALL_COLLECTOR_ENABLED=1
PLAYBALL_RESULT_LOOKBACK_DAYS=30
PLAYBALL_RESULT_CORRECTION_DAYS=7

# refresh=1 강제 갱신용 선택적 비밀값. 비어 있으면 강제 갱신은 비활성화됩니다.
PLAYBALL_REFRESH_TOKEN=
